# ---- Market data -------------------------------------------------------------
# synthetic = built-in demo market (default)
# yahoo     = Yahoo Finance via yfinance (personal use only, not for a paid app)
# fmp       = Financial Modeling Prep (commercially licensable; needs FMP_API_KEY)
MONEY_PROVIDER=synthetic
MONEY_CACHE_DIR=/data/cache
FMP_API_KEY=

# ---- Storage -----------------------------------------------------------------
MONEY_DB=/data/money.db

# ---- Public URL (used for Stripe redirect URLs) -------------------------------
MONEY_PUBLIC_URL=https://your-domain.com
# Comma-separated origins allowed to call the API cross-origin (blank = any).
MONEY_CORS_ORIGINS=

# ---- Billing -----------------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty and MONEY_BILLING unset for a free, self-hosted
# install (no paywall). MONEY_BILLING=dev fakes checkout for local testing.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_WEEKLY=price_...
STRIPE_PRICE_MONTHLY=price_...
MONEY_PRICE_WEEKLY_DISPLAY=$9.99
MONEY_PRICE_MONTHLY_DISPLAY=$29.99
MONEY_TRIAL_DAYS=7

# ---- Email (password resets) --------------------------------------------------
# Any SMTP service works (Postmark, SES, Resend, Mailgun...). Without SMTP_HOST,
# reset links are only written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Money <no-reply@your-domain.com>

# ---- Demo content ------------------------------------------------------------
# Seed public "strategy bot" traders so the leaderboard is never empty (1/0).
MONEY_SEED_BOTS=1
